# Copy to .env for local `vercel dev` testing. In production, set these in the
# Vercel dashboard (Project Settings -> Environment Variables) — never commit real values.

# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Resend API key (resend.com) — used to email new leads
RESEND_API_KEY=

# Optional: verified sender identity once a domain is set up in Resend.
# Defaults to onboarding@resend.dev (Resend's no-setup sandbox sender) if unset.
RESEND_FROM=StrongFist Leads <onboarding@resend.dev>

# Optional: override who receives new-lead emails. Defaults to strongfist000@gmail.com.
LEAD_NOTIFY_EMAIL=strongfist000@gmail.com

# Shared password for the /leads page (HTTP Basic Auth — any username, this
# password). Required: /leads returns 500 if it is unset. Set a real value in
# the Vercel dashboard or via `vercel env add` — never commit one here.
LEADS_PASSWORD=
